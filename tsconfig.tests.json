{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "rootDir": ".",
        "types": ["node"],
        // `extends` replaces `paths` rather than merging it, so the eslint entry that
        // tsconfig.json declares is repeated here alongside the vitest entry.
        "paths": {
            "eslint": ["./.github/ci/typescript/node_modules/eslint/lib/types/index.d.ts"],
            "vitest": ["./.github/ci/typescript/node_modules/vitest/dist/index.d.ts"]
        }
    },
    "include": ["src/**/*", "tests/**/*"],
    "exclude": ["node_modules", "dist", ".github"]
}
